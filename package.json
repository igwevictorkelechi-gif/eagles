{
  "name": "sas-school-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SAS — Multi-tenant School Administration SaaS on Cloudflare",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply sas_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sas_db --remote",
    "db:seed:local": "wrangler d1 execute sas_db --local --file=./schema/seed.sql",
    "db:seed:remote": "wrangler d1 execute sas_db --remote --file=./schema/seed.sql",
    "cf:dev": "wrangler pages dev -- npm run dev",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^3.91.0"
  }
}
